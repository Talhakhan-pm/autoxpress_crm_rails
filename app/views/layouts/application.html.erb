<!DOCTYPE html>
<html>
  <head>
    <title>AutoXpress CRM</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="bg-gray-50 font-sans antialiased">
    <!-- AutoXpress Navigation Header -->
    <nav class="bg-gradient-to-r from-red-600 to-red-700 shadow-lg">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <!-- Logo and Brand -->
            <div class="flex-shrink-0 flex items-center">
              <div class="bg-white p-2 rounded-lg shadow-md">
                <svg class="h-8 w-8 text-red-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.22.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/>
                </svg>
              </div>
              <div class="ml-3">
                <h1 class="text-2xl font-bold text-white">AutoXpress</h1>
                <p class="text-red-100 text-sm">CRM System</p>
              </div>
            </div>

            <!-- Navigation Links -->
            <div class="hidden md:ml-10 md:flex md:space-x-8">
              <%= link_to "Dashboard", root_path, class: "text-red-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200" %>
              <%= link_to "Callbacks", agent_callbacks_path, class: "text-red-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200" %>
              <a href="#" class="text-red-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200">Orders</a>
              <a href="#" class="text-red-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200">Inventory</a>
              <a href="#" class="text-red-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200">Reports</a>
            </div>
          </div>

          <!-- User Menu -->
          <div class="flex items-center">
            <div class="flex items-center space-x-4">
              <!-- Notifications -->
              <button class="text-red-100 hover:text-white p-2 rounded-full hover:bg-red-600 transition-colors duration-200">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-5 5v-5zM7 7l5-5v5H7zm8 0h5v5l-5-5zM7 17v5l-5-5h5z"/>
                </svg>
              </button>

              <!-- User Profile -->
              <div class="flex items-center space-x-3">
                <div class="text-right">
                  <p class="text-white text-sm font-medium"><%= current_user&.email || "Agent" %></p>
                  <p class="text-red-100 text-xs">Online</p>
                </div>
                <div class="h-8 w-8 bg-red-500 rounded-full flex items-center justify-center">
                  <span class="text-white text-sm font-bold">
                    <%= (current_user&.email&.first || "A").upcase %>
                  </span>
                </div>
                <% if user_signed_in? %>
                  <%= link_to destroy_user_session_path, method: :delete, class: "text-red-100 hover:text-white p-2 rounded-full hover:bg-red-600 transition-colors duration-200" do %>
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                    </svg>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden px-4 pb-3">
        <div class="space-y-1">
          <%= link_to "Dashboard", root_path, class: "block text-red-100 hover:text-white px-3 py-2 rounded-md text-base font-medium" %>
          <%= link_to "Callbacks", agent_callbacks_path, class: "block text-red-100 hover:text-white px-3 py-2 rounded-md text-base font-medium" %>
          <a href="#" class="block text-red-100 hover:text-white px-3 py-2 rounded-md text-base font-medium">Orders</a>
          <a href="#" class="block text-red-100 hover:text-white px-3 py-2 rounded-md text-base font-medium">Inventory</a>
          <a href="#" class="block text-red-100 hover:text-white px-3 py-2 rounded-md text-base font-medium">Reports</a>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main>
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-800 text-white mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col md:flex-row justify-between items-center">
          <div class="flex items-center space-x-2">
            <div class="bg-red-600 p-1 rounded">
              <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.22.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/>
              </svg>
            </div>
            <span class="font-bold">AutoXpress CRM</span>
          </div>
          <div class="mt-4 md:mt-0 text-gray-400 text-sm">
            © 2025 AutoXpress. All rights reserved.
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
