<!-- Page Header with Minimal Branding -->
<div class="bg-white border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between">
      <div class="flex items-center space-x-4">
        <div class="bg-gray-100 p-3 rounded-xl border border-gray-200">
          <svg class="h-8 w-8 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
        </div>
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Customer Callbacks</h1>
          <p class="mt-1 text-lg text-gray-700">Automotive Parts Follow-up System</p>
          <p class="text-sm text-gray-500">Manage customer inquiries and follow-up schedules</p>
        </div>
      </div>
      
      <div class="mt-6 md:mt-0">
        <%= link_to new_agent_callback_path, class: "inline-flex items-center justify-center px-6 py-3 border border-transparent rounded-lg shadow-sm text-base font-medium text-white bg-red-600 hover:bg-red-700 transition-colors duration-200" do %>
          <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
          </svg>
          New Callback
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Analytics Dashboard -->
<div class="bg-gray-50 border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Conversion Analytics</h2>
    
    <!-- Key Metrics Row -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
      <!-- Total Callbacks -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
        <div class="text-center">
          <div class="text-2xl font-bold text-gray-900"><%= @analytics[:total_callbacks] %></div>
          <div class="text-sm text-gray-600">Total Callbacks</div>
        </div>
      </div>
      
      <!-- Conversion Rate -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
        <div class="text-center">
          <div class="text-2xl font-bold text-green-600"><%= @analytics[:conversion_metrics][:conversion_rate] %>%</div>
          <div class="text-sm text-gray-600">Conversion Rate</div>
          <div class="text-xs text-gray-500">(30 days)</div>
        </div>
      </div>
      
      <!-- Completed -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
        <div class="text-center">
          <div class="text-2xl font-bold text-green-600"><%= @analytics[:conversion_metrics][:completed] %></div>
          <div class="text-sm text-gray-600">Completed</div>
          <div class="text-xs text-gray-500">(30 days)</div>
        </div>
      </div>
      
      <!-- In Progress -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
        <div class="text-center">
          <div class="text-2xl font-bold text-blue-600"><%= @analytics[:conversion_metrics][:in_progress] %></div>
          <div class="text-sm text-gray-600">In Progress</div>
        </div>
      </div>
      
      <!-- Avg Views -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
        <div class="text-center">
          <div class="text-2xl font-bold text-purple-600"><%= @analytics[:conversion_metrics][:avg_views_per_callback].round(1) %></div>
          <div class="text-sm text-gray-600">Avg Views</div>
          <div class="text-xs text-gray-500">Per Callback</div>
        </div>
      </div>
    </div>
    
    <!-- Status Breakdown & Activity -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Status Breakdown -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
        <h3 class="text-md font-medium text-gray-900 mb-3">Status Breakdown</h3>
        <div class="space-y-2">
          <% @analytics[:status_breakdown].each do |status, count| %>
            <div class="flex justify-between items-center">
              <span class="text-sm font-medium text-gray-700"><%= status&.humanize || 'No Status' %></span>
              <div class="flex items-center space-x-2">
                <span class="text-sm text-gray-900"><%= count %></span>
                <div class="w-16 bg-gray-200 rounded-full h-2">
                  <div class="h-2 rounded-full 
                    <%= case status
                        when 'pending' then 'bg-yellow-500'
                        when 'completed' then 'bg-green-500'
                        when 'in_progress' then 'bg-blue-500'
                        when 'cancelled' then 'bg-red-500'
                        else 'bg-gray-500'
                        end %>" 
                       style="width: <%= (count.to_f / @analytics[:total_callbacks] * 100).round(1) %>%"></div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
      
      <!-- Recent Activity (24h) -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
        <h3 class="text-md font-medium text-gray-900 mb-3">Recent Activity (24h)</h3>
        <div class="space-y-2">
          <% if @analytics[:recent_activity].any? %>
            <% @analytics[:recent_activity].each do |activity_type, count| %>
              <div class="flex justify-between items-center">
                <span class="text-sm font-medium text-gray-700"><%= activity_type.humanize %></span>
                <span class="text-sm text-gray-900"><%= count %></span>
              </div>
            <% end %>
          <% else %>
            <div class="text-sm text-gray-500 text-center py-2">No recent activity</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Main Content Area -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <% if @agent_callbacks.any? %>
    <!-- Callbacks Table -->
    <div class="bg-white shadow-lg rounded-xl border border-gray-200 overflow-hidden">
      <!-- Table Header -->
      <div class="bg-gray-50 border-b border-gray-200 px-6 py-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-gray-900 flex items-center">
            <svg class="w-5 h-5 mr-2 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            Recent Callback Requests
          </h2>
          <div class="text-gray-600 text-sm">
            <span class="bg-green-100 text-green-800 px-2 py-1 rounded-full text-xs font-medium">Live Updates</span>
          </div>
        </div>
      </div>
      
      <!-- Table Content -->
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">
                <div class="flex items-center space-x-1">
                  <span>Customer Details</span>
                </div>
              </th>
              <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">
                <div class="flex items-center space-x-1">
                  <svg class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                  </svg>
                  <span>Product Interest</span>
                </div>
              </th>
              <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">
                <div class="flex items-center space-x-1">
                  <svg class="w-4 h-4 text-gray-500" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.22.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/>
                  </svg>
                  <span>Vehicle Info</span>
                </div>
              </th>
              <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Status</th>
              <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Follow-up</th>
              <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Agent</th>
              <th class="px-6 py-4 text-left text-xs font-bold text-gray-700 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody id="callbacks-list" class="bg-white divide-y divide-gray-200">
            <% @agent_callbacks.each do |callback| %>
              <tr class="hover:bg-gray-50 transition-colors duration-200 group" data-callback-id="<%= callback.id %>">
                <!-- Customer Details -->
                <td class="px-6 py-4">
                  <div class="flex items-center space-x-3">
                    <div>
                      <div class="text-sm font-semibold text-gray-900"><%= callback.customer_name %></div>
                      <div class="text-sm text-blue-600 font-medium">
                        <a href="tel:<%= callback.callback_number %>" class="hover:text-blue-800 transition-colors duration-200">
                          📞 <%= callback.callback_number %>
                        </a>
                      </div>
                      <div class="text-xs text-gray-500">
                        <span class="inline-flex items-center">
                          <svg class="w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                          </svg>
                          <%= callback.zip || "No ZIP" %>
                        </span>
                      </div>
                    </div>
                  </div>
                </td>

                <!-- Product Interest -->
                <td class="px-6 py-4">
                  <div class="text-sm font-medium text-gray-900"><%= callback.product || "General Inquiry" %></div>
                  <div class="text-xs text-gray-500 mt-1">Product inquiry</div>
                </td>

                <!-- Vehicle Info -->
                <td class="px-6 py-4">
                  <div class="text-sm font-medium text-gray-900"><%= callback.car_make_model || "Not specified" %></div>
                  <div class="text-xs text-gray-500">
                    <span class="inline-flex items-center">
                      <svg class="w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                      <%= callback.year || "Year N/A" %>
                    </span>
                  </div>
                </td>

                <!-- Status -->
                <td class="px-6 py-4">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold 
                    <%= case callback.status
                        when 'pending' then 'bg-yellow-100 text-yellow-800 border border-yellow-200'
                        when 'completed' then 'bg-green-100 text-green-800 border border-green-200'
                        when 'in_progress' then 'bg-blue-100 text-blue-800 border border-blue-200'
                        when 'cancelled' then 'bg-red-100 text-red-800 border border-red-200'
                        else 'bg-gray-100 text-gray-800 border border-gray-200'
                        end %>">
                    <span class="w-1.5 h-1.5 rounded-full mr-2 
                      <%= case callback.status
                          when 'pending' then 'bg-yellow-400'
                          when 'completed' then 'bg-green-400'
                          when 'in_progress' then 'bg-blue-400'
                          when 'cancelled' then 'bg-red-400'
                          else 'bg-gray-400'
                          end %>"></span>
                    <%= callback.status&.humanize || 'Pending' %>
                  </span>
                </td>

                <!-- Follow-up Date -->
                <td class="px-6 py-4">
                  <div class="text-sm text-gray-900">
                    <%= callback.follow_up_date&.strftime("%b %d, %Y") || "Not scheduled" %>
                  </div>
                  <% if callback.follow_up_date %>
                    <div class="text-xs text-gray-500">
                      <%= time_ago_in_words(callback.follow_up_date) %> 
                      <%= callback.follow_up_date.future? ? "from now" : "ago" %>
                    </div>
                  <% end %>
                </td>

                <!-- Agent -->
                <td class="px-6 py-4">
                  <div class="flex items-center space-x-2">
                    <div class="w-6 h-6 bg-gray-600 rounded-full flex items-center justify-center">
                      <span class="text-white text-xs font-bold">
                        <%= callback.agent_name&.first&.upcase || "A" %>
                      </span>
                    </div>
                    <div class="text-sm text-gray-900"><%= callback.agent_name&.split('@')&.first || "Unassigned" %></div>
                  </div>
                </td>

                <!-- Actions -->
                <td class="px-6 py-4">
                  <div class="flex items-center space-x-3">
                    <%= link_to callback, class: "text-blue-600 hover:text-blue-800 font-medium text-sm transition-colors duration-200" do %>
                      <svg class="w-4 h-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                      </svg>
                      View
                    <% end %>
                    <%= link_to edit_agent_callback_path(callback), class: "text-indigo-600 hover:text-indigo-800 font-medium text-sm transition-colors duration-200" do %>
                      <svg class="w-4 h-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                      </svg>
                      Edit
                    <% end %>
                    <%= link_to callback, method: :delete, 
                        confirm: "Are you sure you want to delete this callback?", 
                        class: "text-gray-500 hover:text-red-600 font-medium text-sm transition-colors duration-200" do %>
                      <svg class="w-4 h-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                      </svg>
                      Delete
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="bg-white shadow-lg rounded-xl border border-gray-200 overflow-hidden">
      <div class="text-center py-16">
        <div class="bg-gray-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-10 h-10 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">No Customer Callbacks Yet</h3>
        <p class="text-gray-600 mb-8 max-w-md mx-auto">
          Start building your customer relationships by creating your first callback. 
          Track inquiries, schedule follow-ups, and never miss a potential sale.
        </p>
        <%= link_to new_agent_callback_path, class: "inline-flex items-center px-6 py-3 border border-transparent rounded-lg shadow-sm text-base font-medium text-white bg-red-600 hover:bg-red-700 transition-colors duration-200" do %>
          <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
          </svg>
          Create First Callback
        <% end %>
      </div>
    </div>
  <% end %>
</div>
