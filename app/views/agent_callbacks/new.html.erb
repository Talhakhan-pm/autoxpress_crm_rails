<!-- Page Header with Minimal Branding -->
<div class="bg-white border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between">
      <div class="flex items-center space-x-4">
        <div class="bg-gray-100 p-3 rounded-xl border border-gray-200">
          <svg class="h-8 w-8 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
          </svg>
        </div>
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Create New Callback</h1>
          <p class="mt-1 text-lg text-gray-700">Automotive Parts Customer Follow-up</p>
          <p class="text-sm text-gray-500">Track customer inquiries and schedule follow-up calls</p>
        </div>
      </div>
      
      <div class="mt-6 md:mt-0">
        <%= link_to agent_callbacks_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors duration-200" do %>
          <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to Callbacks
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Main Content -->
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="bg-white shadow-lg rounded-xl border border-gray-200 overflow-hidden">
    <!-- Form Header -->
    <div class="bg-gray-50 border-b border-gray-200 px-6 py-4">
      <h2 class="text-xl font-bold text-gray-900 flex items-center">
        <svg class="w-5 h-5 mr-2 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        Customer Callback Information
      </h2>
      <p class="text-gray-600 text-sm mt-1">Fill out the details below to create a new callback record</p>
    </div>
    
    <div class="p-8">
      <%= form_with model: @agent_callback, local: true, class: "space-y-8" do |form| %>
        <!-- Error Display -->
        <% if @agent_callback.errors.any? %>
          <div class="bg-red-50 border-l-4 border-red-400 p-4 rounded-lg">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(@agent_callback.errors.count, "error") %> prohibited this callback from being saved:
                </h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc pl-5 space-y-1">
                    <% @agent_callback.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Customer Information Section -->
        <div class="bg-blue-50 rounded-xl p-6 border border-blue-200">
          <div class="flex items-center mb-6">
            <div class="bg-blue-600 p-2 rounded-lg">
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-lg font-bold text-gray-900">Customer Information</h3>
              <p class="text-sm text-blue-600">Primary contact details and location</p>
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= form.label :customer_name, class: "block text-sm font-bold text-gray-700 mb-2" do %>
                <span class="flex items-center">
                  <svg class="w-4 h-4 mr-1 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                  Customer Name *
                </span>
              <% end %>
              <%= form.text_field :customer_name, 
                  placeholder: "Enter customer's full name",
                  class: "mt-1 block w-full border-blue-200 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200" %>
            </div>

            <div>
              <%= form.label :callback_number, class: "block text-sm font-bold text-gray-700 mb-2" do %>
                <span class="flex items-center">
                  <svg class="w-4 h-4 mr-1 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                  Phone Number *
                </span>
              <% end %>
              <%= form.text_field :callback_number, 
                  placeholder: "(555) 123-4567",
                  class: "mt-1 block w-full border-blue-200 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200" %>
            </div>

            <div class="md:col-span-2">
              <%= form.label :zip, "ZIP Code", class: "block text-sm font-bold text-gray-700 mb-2" do %>
                <span class="flex items-center">
                  <svg class="w-4 h-4 mr-1 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  ZIP Code
                </span>
              <% end %>
              <%= form.text_field :zip, 
                  placeholder: "Enter ZIP code for location",
                  class: "mt-1 block w-full md:w-1/3 border-blue-200 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200" %>
            </div>
          </div>
        </div>

        <!-- Product & Vehicle Section -->
        <div class="bg-green-50 rounded-xl p-6 border border-green-200">
          <div class="flex items-center mb-6">
            <div class="bg-green-600 p-2 rounded-lg">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.22.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/>
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-lg font-bold text-gray-900">Product & Vehicle Details</h3>
              <p class="text-sm text-green-600">Automotive parts and vehicle information</p>
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= form.label :product, class: "block text-sm font-bold text-gray-700 mb-2" do %>
                <span class="flex items-center">
                  <svg class="w-4 h-4 mr-1 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                  </svg>
                  Product Interest
                </span>
              <% end %>
              <%= form.text_field :product, 
                  placeholder: "Brake pads, transmission, etc.",
                  class: "mt-1 block w-full border-blue-200 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200" %>
            </div>

            <div>
              <%= form.label :car_make_model, "Vehicle Make & Model", class: "block text-sm font-bold text-gray-700 mb-2" do %>
                <span class="flex items-center">
                  <svg class="w-4 h-4 mr-1 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.22.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/>
                  </svg>
                  Make & Model
                </span>
              <% end %>
              <%= form.text_field :car_make_model, 
                  placeholder: "Honda Civic, Ford F-150, etc.",
                  class: "mt-1 block w-full border-blue-200 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200" %>
            </div>

            <div class="md:col-span-2">
              <%= form.label :year, class: "block text-sm font-bold text-gray-700 mb-2" do %>
                <span class="flex items-center">
                  <svg class="w-4 h-4 mr-1 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  Vehicle Year
                </span>
              <% end %>
              <%= form.number_field :year, 
                  min: 1900, max: Date.current.year + 1,
                  placeholder: "Enter 4-digit year",
                  class: "mt-1 block w-full md:w-1/3 border-blue-200 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200" %>
            </div>
          </div>
        </div>

        <!-- Follow-up & Status Section -->
        <div class="bg-yellow-50 rounded-xl p-6 border border-yellow-200">
          <div class="flex items-center mb-6">
            <div class="bg-yellow-600 p-2 rounded-lg">
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-lg font-bold text-gray-900">Follow-up & Status</h3>
              <p class="text-sm text-yellow-600">Schedule and track callback progress</p>
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= form.label :status, class: "block text-sm font-bold text-gray-700 mb-2" do %>
                <span class="flex items-center">
                  <svg class="w-4 h-4 mr-1 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  Status
                </span>
              <% end %>
              <%= form.select :status, 
                  options_for_select([
                    ['Pending', 'pending'],
                    ['In Progress', 'in_progress'],
                    ['Completed', 'completed'],
                    ['Cancelled', 'cancelled']
                  ], @agent_callback.status || 'pending'),
                  { prompt: 'Select current status' },
                  { class: "mt-1 block w-full border-yellow-200 rounded-lg shadow-sm focus:ring-yellow-500 focus:border-yellow-500 transition-colors duration-200" } %>
            </div>

            <div>
              <%= form.label :follow_up_date, class: "block text-sm font-bold text-gray-700 mb-2" do %>
                <span class="flex items-center">
                  <svg class="w-4 h-4 mr-1 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  Follow-up Date
                </span>
              <% end %>
              <%= form.date_field :follow_up_date, 
                  min: Date.current,
                  class: "mt-1 block w-full border-yellow-200 rounded-lg shadow-sm focus:ring-yellow-500 focus:border-yellow-500 transition-colors duration-200" %>
            </div>
          </div>
        </div>

        <!-- Comments Section -->
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
          <div class="flex items-center mb-4">
            <div class="bg-gray-600 p-2 rounded-lg">
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-1.586l-4 4z"/>
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-lg font-bold text-gray-900">Additional Notes</h3>
              <p class="text-sm text-gray-600">Customer comments, requirements, or special instructions</p>
            </div>
          </div>
          
          <%= form.label :comments, class: "block text-sm font-bold text-gray-700 mb-2" do %>
            <span class="flex items-center">
              <svg class="w-4 h-4 mr-1 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
              </svg>
              Comments & Notes
            </span>
          <% end %>
          <%= form.text_area :comments, 
              rows: 4, 
              placeholder: "Add any relevant notes about the customer inquiry, specific requirements, or conversation details...",
              class: "mt-1 block w-full border-gray-200 rounded-lg shadow-sm focus:ring-gray-500 focus:border-gray-500 transition-colors duration-200" %>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row justify-end space-y-3 sm:space-y-0 sm:space-x-4 pt-6 border-t border-gray-200">
          <%= link_to agent_callbacks_path, class: "inline-flex justify-center items-center px-6 py-3 border border-gray-300 rounded-lg shadow-sm text-base font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors duration-200" do %>
            <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            Cancel
          <% end %>
          <%= form.submit "Create Callback", class: "inline-flex justify-center items-center px-6 py-3 border border-transparent rounded-lg shadow-sm text-base font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors duration-200" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
