<div class="min-h-screen bg-gray-50">
  <!-- Header -->
  <div class="bg-white shadow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center py-6">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Callback Details</h1>
          <p class="mt-1 text-sm text-gray-600">View callback for <%= @agent_callback.customer_name %></p>
        </div>
        <div class="flex space-x-3">
          <%= link_to edit_agent_callback_path(@agent_callback), class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-medium" do %>
            Edit Callback
          <% end %>
          <%= link_to agent_callbacks_path, class: "bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-md text-sm font-medium" do %>
            Back to Callbacks
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <!-- Status Badge -->
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-medium text-gray-900">Callback Information</h2>
          <span class="inline-flex px-3 py-1 text-sm font-semibold rounded-full 
            <%= case @agent_callback.status
                when 'pending' then 'bg-yellow-100 text-yellow-800'
                when 'completed' then 'bg-green-100 text-green-800'
                when 'in_progress' then 'bg-blue-100 text-blue-800'
                when 'cancelled' then 'bg-red-100 text-red-800'
                else 'bg-gray-100 text-gray-800'
                end %>">
            <%= @agent_callback.status&.humanize %>
          </span>
        </div>
      </div>
      
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Customer Information -->
          <div>
            <h3 class="text-lg font-medium text-gray-900 mb-4">Customer Information</h3>
            <dl class="space-y-3">
              <div>
                <dt class="text-sm font-medium text-gray-500">Customer Name</dt>
                <dd class="text-sm text-gray-900"><%= @agent_callback.customer_name %></dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500">Phone Number</dt>
                <dd class="text-sm text-gray-900">
                  <a href="tel:<%= @agent_callback.callback_number %>" class="text-blue-600 hover:text-blue-800">
                    <%= @agent_callback.callback_number %>
                  </a>
                </dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500">ZIP Code</dt>
                <dd class="text-sm text-gray-900"><%= @agent_callback.zip || "Not provided" %></dd>
              </div>
            </dl>
          </div>

          <!-- Product & Vehicle Information -->
          <div>
            <h3 class="text-lg font-medium text-gray-900 mb-4">Product & Vehicle</h3>
            <dl class="space-y-3">
              <div>
                <dt class="text-sm font-medium text-gray-500">Product</dt>
                <dd class="text-sm text-gray-900"><%= @agent_callback.product || "Not specified" %></dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500">Car Make & Model</dt>
                <dd class="text-sm text-gray-900"><%= @agent_callback.car_make_model || "Not specified" %></dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500">Year</dt>
                <dd class="text-sm text-gray-900"><%= @agent_callback.year || "Not specified" %></dd>
              </div>
            </dl>
          </div>
        </div>

        <!-- Follow-up and Agent Information -->
        <div class="mt-8 pt-8 border-t border-gray-200">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <h3 class="text-lg font-medium text-gray-900 mb-4">Follow-up Information</h3>
              <dl class="space-y-3">
                <div>
                  <dt class="text-sm font-medium text-gray-500">Follow-up Date</dt>
                  <dd class="text-sm text-gray-900">
                    <%= @agent_callback.follow_up_date&.strftime("%B %d, %Y") || "Not scheduled" %>
                  </dd>
                </div>
                <div>
                  <dt class="text-sm font-medium text-gray-500">Agent</dt>
                  <dd class="text-sm text-gray-900"><%= @agent_callback.agent_name %></dd>
                </div>
              </dl>
            </div>

            <div>
              <h3 class="text-lg font-medium text-gray-900 mb-4">Tracking Information</h3>
              <dl class="space-y-3">
                <div>
                  <dt class="text-sm font-medium text-gray-500">Created</dt>
                  <dd class="text-sm text-gray-900"><%= @agent_callback.created_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
                </div>
                <div>
                  <dt class="text-sm font-medium text-gray-500">Last Modified</dt>
                  <dd class="text-sm text-gray-900">
                    <%= (@agent_callback.last_modified || @agent_callback.updated_at).strftime("%B %d, %Y at %I:%M %p") %>
                  </dd>
                </div>
                <% if @agent_callback.last_modified_by.present? %>
                  <div>
                    <dt class="text-sm font-medium text-gray-500">Last Modified By</dt>
                    <dd class="text-sm text-gray-900"><%= @agent_callback.last_modified_by %></dd>
                  </div>
                <% end %>
              </dl>
            </div>
          </div>
        </div>

        <!-- Comments -->
        <% if @agent_callback.comments.present? %>
          <div class="mt-8 pt-8 border-t border-gray-200">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Comments</h3>
            <div class="bg-gray-50 rounded-lg p-4">
              <p class="text-sm text-gray-700 whitespace-pre-wrap"><%= @agent_callback.comments %></p>
            </div>
          </div>
        <% end %>

        <!-- Activity Summary -->
        <div class="mt-8 pt-8 border-t border-gray-200">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Activity Summary</h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-blue-50 p-4 rounded-lg text-center">
              <div class="text-2xl font-bold text-blue-600"><%= @activity_summary[:views] %></div>
              <div class="text-sm text-blue-800">Views</div>
            </div>
            <div class="bg-green-50 p-4 rounded-lg text-center">
              <div class="text-2xl font-bold text-green-600"><%= @activity_summary[:updates] %></div>
              <div class="text-sm text-green-800">Updates</div>
            </div>
            <div class="bg-yellow-50 p-4 rounded-lg text-center">
              <div class="text-2xl font-bold text-yellow-600"><%= @activity_summary[:status_changes] %></div>
              <div class="text-sm text-yellow-800">Status Changes</div>
            </div>
            <div class="bg-purple-50 p-4 rounded-lg text-center">
              <div class="text-2xl font-bold text-purple-600"><%= @activity_summary[:follow_ups] %></div>
              <div class="text-sm text-purple-800">Follow-ups</div>
            </div>
          </div>
        </div>

        <!-- Activity Timeline -->
        <div class="mt-8 pt-8 border-t border-gray-200">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Activity Timeline</h3>
          <div class="flow-root">
            <ul class="max-h-64 overflow-y-auto space-y-3">
              <% @recent_activities.each_with_index do |activity, index| %>
                <li class="relative">
                  <div class="flex items-start space-x-3">
                    <!-- Activity Icon -->
                    <div class="flex-shrink-0">
                      <div class="w-8 h-8 rounded-full flex items-center justify-center
                        <%= case activity.activity_type
                            when 'viewed' then 'bg-blue-100'
                            when 'created' then 'bg-green-100'
                            when 'updated' then 'bg-yellow-100'
                            when 'status_changed' then 'bg-purple-100'
                            when 'follow_up_scheduled' then 'bg-indigo-100'
                            else 'bg-gray-100'
                            end %>">
                        <%= case activity.activity_type
                            when 'viewed'
                              content_tag(:svg, content_tag(:path, '', 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'stroke-width': '2', d: 'M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z'), class: 'w-4 h-4 text-blue-600', fill: 'none', viewBox: '0 0 24 24', stroke: 'currentColor')
                            when 'created'
                              content_tag(:svg, content_tag(:path, '', 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'stroke-width': '2', d: 'M12 6v6m0 0v6m0-6h6m-6 0H6'), class: 'w-4 h-4 text-green-600', fill: 'none', viewBox: '0 0 24 24', stroke: 'currentColor')
                            when 'updated'
                              content_tag(:svg, content_tag(:path, '', 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'stroke-width': '2', d: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z'), class: 'w-4 h-4 text-yellow-600', fill: 'none', viewBox: '0 0 24 24', stroke: 'currentColor')
                            when 'status_changed'
                              content_tag(:svg, content_tag(:path, '', 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'stroke-width': '2', d: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'), class: 'w-4 h-4 text-purple-600', fill: 'none', viewBox: '0 0 24 24', stroke: 'currentColor')
                            when 'follow_up_scheduled'
                              content_tag(:svg, content_tag(:path, '', 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'stroke-width': '2', d: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z'), class: 'w-4 h-4 text-indigo-600', fill: 'none', viewBox: '0 0 24 24', stroke: 'currentColor')
                            else
                              content_tag(:svg, content_tag(:path, '', 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'stroke-width': '2', d: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'), class: 'w-4 h-4 text-gray-600', fill: 'none', viewBox: '0 0 24 24', stroke: 'currentColor')
                            end %>
                      </div>
                    </div>
                    
                    <!-- Activity Content -->
                    <div class="flex-1 min-w-0">
                      <div class="text-sm font-medium text-gray-900">
                        <%= activity.user.email.split('@').first.humanize %> 
                        <%= case activity.activity_type
                            when 'viewed' then 'viewed this callback'
                            when 'created' then 'created this callback'
                            when 'updated' then 'updated this callback'
                            when 'status_changed'
                              details = activity.formatted_details
                              if details.is_a?(Hash) && details['from'] && details['to']
                                "changed status from #{details['from'].humanize} to #{details['to'].humanize}"
                              else
                                'changed the status'
                              end
                            when 'follow_up_scheduled'
                              details = activity.formatted_details
                              if details.is_a?(Hash) && details['date']
                                "scheduled follow-up for #{Date.parse(details['date']).strftime('%B %d, %Y')}"
                              else
                                'scheduled a follow-up'
                              end
                            else
                              activity.activity_type.humanize.downcase
                            end %>
                      </div>
                      <div class="text-xs text-gray-500 flex items-center space-x-2">
                        <span><%= time_ago_in_words(activity.occurred_at) %> ago</span>
                        <span>•</span>
                        <span><%= activity.occurred_at.strftime('%I:%M %p') %></span>
                        <% if activity.ip_address.present? %>
                          <span>•</span>
                          <span><%= activity.ip_address %></span>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </li>
              <% end %>
              
              <% if @recent_activities.empty? %>
                <li class="text-center py-4">
                  <div class="text-sm text-gray-500">No activity recorded yet</div>
                </li>
              <% end %>
            </ul>
          </div>
        </div>

        <!-- Actions -->
        <div class="mt-8 pt-8 border-t border-gray-200 flex justify-between">
          <div class="flex space-x-3">
            <%= link_to edit_agent_callback_path(@agent_callback), class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-medium" do %>
              Edit Callback
            <% end %>
            <%= link_to agent_callbacks_path, class: "bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-md text-sm font-medium" do %>
              Back to List
            <% end %>
          </div>
          <div>
            <%= link_to @agent_callback, method: :delete, 
                confirm: "Are you sure you want to delete this callback?", 
                class: "bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm font-medium" do %>
              Delete Callback
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
